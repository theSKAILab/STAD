                    rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                    rdfs:label "maximum calculation"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A data transformation that returns the maximum input value."@en .


###  http://purl.org/spatialai/stad/v2/core#MedianCalculation
:MedianCalculation rdf:type owl:NamedIndividual ,
                            :CentralTendencyCalculationDataTransformation ;
                   rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                   rdfs:label "median calculation"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A data transformation that calculates the median of a set of values."@en .


###  http://purl.org/spatialai/stad/v2/core#MinimumCalculation
:MinimumCalculation rdf:type owl:NamedIndividual ,
                             :ExtremumCalculationDataTransformation ;
                    rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                    rdfs:label "minimum calculation"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A data transformation that returns the minimum input value."@en .


###  http://purl.org/spatialai/stad/v2/core#ModeCalculation
:ModeCalculation rdf:type owl:NamedIndividual ,
                          :CentralTendencyCalculationDataTransformation ;
                 rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                 rdfs:label "mode calculation"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A data transformation that returns the most frequently occurring input value."@en .


###  http://purl.org/spatialai/stad/v2/core#spatialResolutionQualityKind
:spatialResolutionQualityKind rdf:type owl:NamedIndividual ,
                                       :QualityKind ;
                              rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                              rdfs:label "spatial resolution"@en ;
                              <http://www.w3.org/2004/02/skos/core#definition> "The quality kind describing the spatial granularity or spatial sampling of a dataset."@en .


###  http://purl.org/spatialai/stad/v2/core#temporalResolutionQualityKind
:temporalResolutionQualityKind rdf:type owl:NamedIndividual ,
                                        :QualityKind ;
                               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                               rdfs:label "temporal resolution"@en ;
                               <http://www.w3.org/2004/02/skos/core#definition> "The quality kind describing the temporal granularity or spacing of observations in a dataset."@en .


