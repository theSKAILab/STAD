###  http://purl.org/spatialai/stad/v2/core#ArithmeticMeanCalculation
:ArithmeticMeanCalculation rdf:type owl:NamedIndividual ,
                                    :AverageCalculationDataTransformation ;
                           rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                           rdfs:label "arithmetic mean calculation"@en ;
                           <http://www.w3.org/2004/02/skos/core#definition> "A data transformation that calculates the arithmetic mean of input values."@en .


###  http://purl.org/spatialai/stad/v2/core#GeometricMeanCalculation
:GeometricMeanCalculation rdf:type owl:NamedIndividual ,
                                   :AverageCalculationDataTransformation ;
                          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                          rdfs:label "geometric mean calculation"@en ;
                          <http://www.w3.org/2004/02/skos/core#definition> "A data transformation that calculates the geometric mean of input values."@en .


###  http://purl.org/spatialai/stad/v2/core#MaximumCalculation
:MaximumCalculation rdf:type owl:NamedIndividual ,
