<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/spatialai/stad/v2/core#"
     xml:base="http://purl.org/spatialai/stad/v2/core"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://purl.org/spatialai/stad/v2/core#">
        <owl:versionIRI rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="https://raw.githubusercontent.com/w3c/sdw/gh-pages/time-aggregates/rdf/time-agg.ttl"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-16</terms:created>
        <terms:creator xml:lang="en">Kate Beard - https://orcid.org/0000-0002-7703-0270</terms:creator>
        <terms:creator xml:lang="en">Kingsley Wiafe-Kwakye - https://orcid.org/0009-0007-3741-3721</terms:creator>
        <terms:creator xml:lang="en">Torsten Hahmann - http://orcid.org/0000-0002-5331-5052</terms:creator>
        <terms:description xml:lang="en">STAD provides syntax for describing the spatial and temporal characteristics of aggregate quantities.</terms:description>
        <terms:identifier xml:lang="en">http://purl.org/spatialai/stad/v2/core&gt;</terms:identifier>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-16</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-09</terms:modified>
        <terms:publisher xml:lang="en">Spatial Knowledge and Artificial Intelligence (SKAI) Lab, University of Maine</terms:publisher>
        <terms:subject>Aggregate data</terms:subject>
        <terms:subject>Spatial aggregate data</terms:subject>
        <terms:subject>Temporal aggregate data</terms:subject>
        <terms:title xml:lang="en">Spatial and Temporal Aggregate Data (STAD) Ontology</terms:title>
        <rdfs:label xml:lang="en">STAD Ontology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.org/spatialai/stad/v2/mls#"/>
        <owl:versionInfo xml:lang="en">2.0</owl:versionInfo>
        <skos:related rdf:resource="http://purl.org/spatialai/stad/v2/mls#"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/subject -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/subject"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#editorialNote -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#related -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#related"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/hasPart -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/hasPart">
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <skos:definition xml:lang="en">related resource that is included either physically or logically in the described resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#containsDatapoint -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#containsDatapoint">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#Dataset"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">contains datapoint</rdfs:label>
        <skos:definition xml:lang="en">Relates a dataset to a datapoint contained in that dataset.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#generatedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#generatedBy">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">generated by</rdfs:label>
        <skos:definition xml:lang="en">Links anything that is generated by an Algorithm to the specific AlgorithmExecution that was used.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasAggregationPeriod -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasAggregationPeriod">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#AggregationPeriod"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has aggregation period</rdfs:label>
        <skos:definition xml:lang="en">Relates a statistical aggregate datapoint to the temporal entities over which its base data were selected for aggregation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasBaseDatapoint -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasBaseDatapoint">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#hasBaseDataset"/>
            <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#containsDatapoint"/>
        </owl:propertyChainAxiom>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has base datapoint</rdfs:label>
        <skos:definition xml:lang="en">Relates a computational datapoint to a datapoint used to compute it; this relation can be inferred through its base dataset.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasBaseDataset -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasBaseDataset">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#Dataset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has base dataset</rdfs:label>
        <skos:definition xml:lang="en">Relates a computational datapoint to a dataset used to compute it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasConvexAggregationPeriod -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasConvexAggregationPeriod">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spatialai/stad/v2/core#hasAggregationPeriod"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#ConvexAggregationPeriod"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has convex aggregation period</rdfs:label>
        <skos:definition xml:lang="en">Relates an aggregate datapoint to a convex aggregation period.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasDataValue -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasDataValue">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#DataValue"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has data value</rdfs:label>
        <skos:definition xml:lang="en">Relates a datapoint to the value it carries.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasDatasetDescription -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasDatasetDescription">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#Dataset"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#DatasetDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has dataset description</rdfs:label>
        <skos:definition xml:lang="en">Relates a dataset to a description of characteristics such as its spatial and temporal resolution.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasExtent -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasExtent">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#AggregationPeriod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has extent</rdfs:label>
        <skos:definition xml:lang="en">Relates an aggregation period to the single proper interval forming its minimal convex temporal extent.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasInput -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasInput">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has input</rdfs:label>
        <skos:definition xml:lang="en">Relates an algorithm execution to an input dataset.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasInstant -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasInstant">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasPart"/>
        <owl:inverseOf rdf:resource="http://purl.org/spatialai/stad/v2/core#instantPartOf"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has instant</rdfs:label>
        <skos:definition xml:lang="en">Relates a temporal aggregate to an instant that is one of its temporal parts.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasInterval -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasInterval">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasPart"/>
        <owl:inverseOf rdf:resource="http://purl.org/spatialai/stad/v2/core#intervalPartOf"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has interval</rdfs:label>
        <skos:definition xml:lang="en">Relates a temporal aggregate to an interval that is one of its temporal parts.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasNonConvexAggregationPeriod -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasNonConvexAggregationPeriod">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spatialai/stad/v2/core#hasAggregationPeriod"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#NonConvexAggregationPeriod"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has non-convex aggregation period</rdfs:label>
        <skos:definition xml:lang="en">Relates an aggregate datapoint to a non-convex aggregation period.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasQualitativeValue -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasQualitativeValue">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spatialai/stad/v2/core#hasDataValue"/>
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#QualitativeDatapoint"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#QualitativeValue"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has qualitative value</rdfs:label>
        <skos:definition xml:lang="en">Relates a qualitative datapoint to its qualitative value.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasQualityKind -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasQualityKind">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#QualityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has quality kind</rdfs:label>
        <skos:definition xml:lang="en">Relates a datapoint to the quality or property kind whose value it represents.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasQuantitativeValue -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasQuantitativeValue">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spatialai/stad/v2/core#hasDataValue"/>
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#QuantitativeDatapoint"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#QuantitativeValue"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has quantitative value</rdfs:label>
        <skos:definition xml:lang="en">Relates a quantitative datapoint to its quantitative value.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasResolution -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasResolution">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#DatasetDescription"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#ResolutionDescriptor"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has resolution</rdfs:label>
        <skos:definition xml:lang="en">Relates a dataset description to a descriptor of one of the dataset&apos;s resolution.</skos:definition>
        <skos:note xml:lang="en">No maximum cardinality is imposed because a dataset may report multiple complementary resolution descriptors.</skos:note>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasSpatialCoverage -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasSpatialCoverage">
        <owl:inverseOf rdf:resource="http://purl.org/spatialai/stad/v2/core#spatialCoverageOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#Dataset"/>
                    <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#SpatialAggregateDatapoint"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#SpatialCoverage"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has spatial coverage</rdfs:label>
        <skos:definition xml:lang="en">Relates a dataset or spatial aggregate datapoint to the spatial extent it covers or summarizes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasSpatialResolution -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasSpatialResolution">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spatialai/stad/v2/core#hasResolution"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#SpatialResolution"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has spatial resolution</rdfs:label>
        <skos:definition xml:lang="en">Relates a dataset description to a descriptor of the dataset&apos;s spatial resolution.</skos:definition>
        <skos:note xml:lang="en">No maximum cardinality is imposed because a dataset may report multiple complementary spatial resolution measures.</skos:note>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasTemporalCoverage -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasTemporalCoverage">
        <owl:inverseOf rdf:resource="http://purl.org/spatialai/stad/v2/core#temporalCoverageOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#Dataset"/>
                    <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#TemporalCoverage"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has temporal coverage</rdfs:label>
        <skos:definition xml:lang="en">Relates a dataset or statistical aggregate datapoint to the overall interval covered by its data.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasTemporalPart -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasTemporalPart">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasPart"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalAggregate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#hasConvexAggregationPeriod"/>
            <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#hasExtent"/>
        </owl:propertyChainAxiom>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label>has a temporal part (STAD relation)</rdfs:label>
        <skos:definition xml:lang="en">Relates a temporal aggregate to one of its constituent temporal entities, including an inferred extent for a convex aggregation period.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasTemporalResolution -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasTemporalResolution">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spatialai/stad/v2/core#hasResolution"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#TemporalResolution"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has temporal resolution</rdfs:label>
        <skos:definition xml:lang="en">Relates a dataset description to a descriptor of the dataset&apos;s temporal resolution.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#hasTransformationKind -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#hasTransformationKind">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spatialai/stad/v2/core#outputOf"/>
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint"/>
        <rdfs:range rdf:resource="http://purl.org/spatialai/stad/v2/core#DataTransformation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">has transformation kind</rdfs:label>
        <skos:definition xml:lang="en">Relates a statistical aggregate datapoint directly to the kind of data transformation used to produce it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#instantPartOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#instantPartOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#isPartOf"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">instant part of</rdfs:label>
        <skos:definition xml:lang="en">Relates an instant to the temporal aggregate of which it is a part.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#intervalPartOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#intervalPartOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#isPartOf"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">interval part of</rdfs:label>
        <skos:definition xml:lang="en">Relates an interval to the temporal aggregate of which it is a part.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#outputOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#outputOf">
        <rdfs:domain rdf:resource="http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">output of</rdfs:label>
        <skos:definition xml:lang="en">Relates a computational datapoint to the algorithm of which it is an output.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#spatialCoverageOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#spatialCoverageOf">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">spatial coverage of</rdfs:label>
        <skos:definition xml:lang="en">Relates a spatial coverage to a dataset or spatial aggregate datapoint that it covers; inverse of has spatial coverage.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/core#temporalCoverageOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/core#temporalCoverageOf">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">temporal coverage of</rdfs:label>
        <skos:definition xml:lang="en">Relates a temporal coverage to a dataset or statistical aggregate datapoint that it covers; inverse of has temporal coverage.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">has geometry</rdfs:label>
        <skos:definition xml:lang="en">A spatial representation for a given Feature.</skos:definition>
        <skos:prefLabel xml:lang="en">has geometry</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#member -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#member"/>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasBeginning">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label xml:lang="en">has beginning</rdfs:label>
        <skos:definition xml:lang="en">Beginning of a temporal entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasEnd">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label xml:lang="en">has end</rdfs:label>
        <skos:definition xml:lang="en">End of a temporal entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasPart -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasPart">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasPart"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#member"/>
        <owl:inverseOf rdf:resource="http://www.w3.org/2006/time#isPartOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalAggregate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/w3c/sdw/gh-pages/time-aggregates/rdf/time-agg.ttl"/>
        <rdfs:label>has a part</rdfs:label>
        <skos:definition xml:lang="en">Relates a temporal aggregate to a constituent temporal entity.</skos:definition>
        <skos:example>
ex:VicSchoolTerms2020
  a time:TemporalAggregate ;
  time:hasPart ex:t1 ;
.
ex:t1
  a time:ProperInterval ;
.
</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasTime -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasTime">
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label xml:lang="en">has time</rdfs:label>
        <skos:definition xml:lang="en">Supports the association of a temporal entity (instant or interval) to any thing</skos:definition>
        <skos:editorialNote xml:lang="en">Feature at risk - added in 2017 revision, and not yet widely used. </skos:editorialNote>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#isPartOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#isPartOf">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalAggregate"/>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/w3c/sdw/gh-pages/time-aggregates/rdf/time-agg.ttl"/>
        <rdfs:label>is a part of</rdfs:label>
        <skos:definition xml:lang="en">Relates a temporal entity to a temporal aggregate of which it is a part.</skos:definition>
        <skos:example>
ex:t1
  a time:ProperInterval ;
  time:isPartOf ex:VicSchoolTerms2020 ;
.
ex:VicSchoolTerms2020
  a time:TemporalAggregate ;
.
</skos:example>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/spatialai/stad/v2/core#AggregationPeriod -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#AggregationPeriod">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalAggregate"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasPart"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasExtent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">aggregation period</rdfs:label>
        <skos:definition xml:lang="en">A temporal aggregate comprising the temporal entities over which base data were selected for an aggregation, together with one minimal convex extent.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#AverageCalculationDataTransformation -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#AverageCalculationDataTransformation">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#CentralTendencyCalculationDataTransformation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">average calculation data transformation</rdfs:label>
        <skos:definition xml:lang="en">A data transformation that calculates an average of input values.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#CentralTendencyCalculationDataTransformation -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#CentralTendencyCalculationDataTransformation">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#DataTransformation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">central tendency calculation data transformation</rdfs:label>
        <skos:definition xml:lang="en">A data transformation that calculates a measure representing the center or typical value of a set of values.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasBaseDatapoint"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasBaseDataset"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/core#Dataset"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#generatedBy"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/spatialai/stad/v2/core#ObservationalDatapoint"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">computational datapoint</rdfs:label>
        <skos:definition xml:lang="en">A datapoint generated by one algorithm execution from one or more base datapoints or datasets.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#ComputationalPredictedDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#ComputationalPredictedDatapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint"/>
        <owl:disjointWith rdf:resource="http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">computational predicted datapoint</rdfs:label>
        <skos:definition xml:lang="en">A computational datapoint whose value is predicted rather than obtained as a statistical aggregate.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#ConvexAggregationPeriod -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#ConvexAggregationPeriod">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#AggregationPeriod"/>
        <owl:disjointWith rdf:resource="http://purl.org/spatialai/stad/v2/core#NonConvexAggregationPeriod"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">convex aggregation period</rdfs:label>
        <skos:definition xml:lang="en">An aggregation period consisting of a single continuous temporal part that matches its overall extent.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#CoverageRatioResolution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#CoverageRatioResolution">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#SpatialResolution"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">coverage ratio resolution</rdfs:label>
        <skos:definition xml:lang="en">A spatial resolution expressed as the ratio of the area represented by observations to the total study area.</skos:definition>
        <skos:note xml:lang="en">The method used to determine the area represented by observations should be specified when it is not determined directly by raster cells or explicit sampling units.</skos:note>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#Data -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#Data">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">data</rdfs:label>
        <skos:definition xml:lang="en">An entity that represents some data.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#DataTransformation -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#DataTransformation">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">data transformation</rdfs:label>
        <skos:definition xml:lang="en">An algorithm that manipulates or converts data from one form into another, including filtering, sorting, aggregation, type conversion, or mathematical operations.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#DataValue -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#DataValue">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">data value</rdfs:label>
        <skos:definition xml:lang="en">A value carried by a datapoint.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#Datapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#Datapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#Data"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasDataValue"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/core#DataValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasQualityKind"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/core#QualityKind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/spatialai/stad/v2/core#Dataset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">datapoint</rdfs:label>
        <skos:definition xml:lang="en">An individual data item that has a quality kind and a corresponding data value.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#Dataset -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#Dataset">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#Data"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#containsDatapoint"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasDatasetDescription"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/core#DatasetDescription"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/spatialai/stad/v2/core#DatasetDescription"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">dataset</rdfs:label>
        <skos:definition xml:lang="en">A collection of datapoints that has an associated dataset description.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#DatasetDescription -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#DatasetDescription">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">dataset description</rdfs:label>
        <skos:definition xml:lang="en">A description of dataset-level characteristics, including spatial and temporal resolution.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#ExtremumCalculationDataTransformation -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#ExtremumCalculationDataTransformation">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#DataTransformation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">extremum calculation data transformation</rdfs:label>
        <skos:definition xml:lang="en">A data transformation that calculates an extreme value, such as a minimum or maximum.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#NonConvexAggregationPeriod -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#NonConvexAggregationPeriod">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#AggregationPeriod"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">non-convex aggregation period</rdfs:label>
        <skos:definition xml:lang="en">An aggregation period composed of multiple disconnected temporal parts.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#ObservationalDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#ObservationalDatapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">observational datapoint</rdfs:label>
        <skos:definition xml:lang="en">A datapoint obtained through observation rather than computation.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#PixelSizeResolution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#PixelSizeResolution">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#SpatialResolution"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">pixel size resolution</rdfs:label>
        <skos:definition xml:lang="en">A spatial resolution expressed by the ground dimensions of a raster or grid cell.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#PointSpacingResolution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#PointSpacingResolution">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#SpatialResolution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasTransformationKind"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">point spacing resolution</rdfs:label>
        <skos:definition xml:lang="en">A spatial resolution expressed by a statistical summary of distances between neighboring sampling locations in non-gridded spatial data.</skos:definition>
        <skos:note xml:lang="en">The method used to identify neighboring datapoints should be specified when it is not evident from the sampling design.</skos:note>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#QualitativeDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#QualitativeDatapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasQualitativeValue"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/core#QualitativeValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/spatialai/stad/v2/core#QuantitativeDatapoint"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">qualitative datapoint</rdfs:label>
        <skos:definition xml:lang="en">A datapoint whose value is qualitative, such as a category or class.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#QualitativeValue -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#QualitativeValue">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#DataValue"/>
        <owl:disjointWith rdf:resource="http://purl.org/spatialai/stad/v2/core#QuantitativeValue"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">qualitative value</rdfs:label>
        <skos:definition xml:lang="en">A non-numerical data value, such as a categorical value.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#QualityKind -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#QualityKind">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">quality kind</rdfs:label>
        <skos:definition xml:lang="en">The kind of quality or property represented by a datapoint, distinct from the value of that quality.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#QuantitativeDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#QuantitativeDatapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#Datapoint"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasQuantitativeValue"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/core#QuantitativeValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">quantitative datapoint</rdfs:label>
        <skos:definition xml:lang="en">A datapoint whose value is quantitative.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#QuantitativeValue -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#QuantitativeValue">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#DataValue"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">quantitative value</rdfs:label>
        <skos:definition xml:lang="en">A numerical data value, typically represented with a numeric value and unit.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#RegularTemporalResolution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#RegularTemporalResolution">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#TemporalResolution"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">regular temporal resolution</rdfs:label>
        <skos:definition xml:lang="en">A temporal resolution expressed by the constant or nominal interval between successive observations.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#ResolutionDescriptor -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#ResolutionDescriptor">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#QuantitativeDatapoint"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasDataValue"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">resolution descriptor</rdfs:label>
        <skos:definition xml:lang="en">A description of the spatial or temporal granularity at which data in a dataset are represented or distinguished.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#SamplingDensityResolution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#SamplingDensityResolution">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#SpatialResolution"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">sampling density resolution</rdfs:label>
        <skos:definition xml:lang="en">A spatial resolution expressed as the number of datapoints or sampling locations per unit area.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#SpatialAggregateDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#SpatialAggregateDatapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasSpatialCoverage"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">spatial aggregate datapoint</rdfs:label>
        <skos:definition xml:lang="en">A statistical aggregate datapoint computed over a spatial extent. It has exactly one spatial coverage.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#SpatialCoverage -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#SpatialCoverage">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">spatial coverage</rdfs:label>
        <skos:definition xml:lang="en">The spatial extent, typically an area, over which base data are aggregated or a dataset applies.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#SpatialResolution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#SpatialResolution">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#ResolutionDescriptor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasQualityKind"/>
                <owl:hasValue rdf:resource="http://purl.org/spatialai/stad/v2/core#spatialResolutionQualityKind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">spatial resolution</rdfs:label>
        <skos:definition xml:lang="en">A resolution descriptor characterizing the spatial granularity or spatial sampling of a dataset.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#SpatioTemporalAggregateDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#SpatioTemporalAggregateDatapoint">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#SpatialAggregateDatapoint"/>
                    <rdf:Description rdf:about="http://purl.org/spatialai/stad/v2/core#TemporalAggregateDatapoint"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">spatio-temporal aggregate datapoint</rdfs:label>
        <skos:definition xml:lang="en">A statistical aggregate datapoint aggregated over both space and time.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasTransformationKind"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasAggregationPeriod"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasSpatialCoverage"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasTemporalCoverage"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">statistical aggregate datapoint</rdfs:label>
        <skos:definition xml:lang="en">A statistical aggregate datapoint is a computational datapoint whose value is a statistical summary of some base data, aggregated using the described data transformation kind. It may have a temporal coverage, an aggregation period, and a spatial coverage.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#TemporalAggregateDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#TemporalAggregateDatapoint">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasAggregationPeriod"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasTemporalCoverage"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">temporal aggregate datapoint</rdfs:label>
        <skos:definition xml:lang="en">A statistical aggregate datapoint aggregated over time and having exactly one temporal coverage and one aggregation period.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#TemporalCoverage -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#TemporalCoverage">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">temporal coverage</rdfs:label>
        <skos:definition xml:lang="en">The proper interval giving the overall temporal boundaries of a dataset or statistical aggregate datapoint.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#TemporalResolution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#TemporalResolution">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#ResolutionDescriptor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasQuantitativeValue"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2006/time#TemporalDuration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasQualityKind"/>
                <owl:hasValue rdf:resource="http://purl.org/spatialai/stad/v2/core#temporalResolutionQualityKind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">temporal resolution</rdfs:label>
        <skos:definition xml:lang="en">A resolution descriptor characterizing the temporal granularity or spacing of observations in a dataset.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#TemporalSpacingResolution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#TemporalSpacingResolution">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/core#TemporalResolution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#hasTransformationKind"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">temporal spacing resolution</rdfs:label>
        <skos:definition xml:lang="en">A temporal resolution expressed by a statistical summary of intervals between observations.</skos:definition>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <owl:disjointWith rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">feature</rdfs:label>
        <skos:definition xml:lang="en">A discrete spatial phenomenon in a universe of discourse.</skos:definition>
        <skos:note xml:lang="en">A Feature represents a uniquely identifiable phenomenon, for example a river or an apple. While such phenomena (and therefore the Features used to represent them) are bounded, their boundaries may be crisp (e.g., the declared boundaries of a state), vague (e.g., the delineation of a valley versus its neighboring mountains), and change with time (e.g., a storm front). While discrete in nature, Features may be created from continuous observations, such as an isochrone that determines the region that can be reached by ambulance within 5 minutes.</skos:note>
        <skos:prefLabel xml:lang="en">Feature</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">geometry</rdfs:label>
        <skos:definition xml:lang="en">A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS).</skos:definition>
        <skos:note xml:lang="en">Geometry can be used as a representation of the shape, extent or location of a Feature and may exist as a self-contained entity.</skos:note>
        <skos:prefLabel xml:lang="en">Geometry</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#SpatialObject -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#SpatialObject">
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">spatial object</rdfs:label>
        <skos:definition xml:lang="en">Anything spatial (being or having a shape, position or an extent).</skos:definition>
        <skos:note xml:lang="en">Subclasses of this class are expected to be used for instance data.</skos:note>
        <skos:prefLabel xml:lang="en">Spatial Object</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Instant -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#Instant">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label xml:lang="en">Time instant</rdfs:label>
        <skos:definition xml:lang="en">A temporal entity with zero extent or duration</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Interval -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#Interval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label xml:lang="en">Time interval</rdfs:label>
        <skos:definition xml:lang="en">A temporal entity with an extent or duration</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#ProperInterval -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#ProperInterval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label xml:lang="en">Proper interval</rdfs:label>
        <skos:definition xml:lang="en">A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#TemporalAggregate -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalAggregate">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasPart"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Note: no ordering relationships are implied amongst the parts. Relationships between temporal entities are supported by explicit properties, such as time:after time:intervalMeets, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/w3c/sdw/gh-pages/time-aggregates/rdf/time-agg.ttl"/>
        <rdfs:label>Temporal aggregate</rdfs:label>
        <skos:definition xml:lang="en">A temporal entity that is an aggregation of one or more temporal entities, without implied ordering among its parts.</skos:definition>
        <skos:example>
ex:VicSchoolTerms2020
  a time:TemporalAggregate ;
  rdfs:label &quot;Public school year - Victoria 2020 &quot; ;
  time:hasBeginning ex:t1b ;
  time:hasEnd ex:t4e ;
  time:hasPart ex:t1 ;
  time:hasPart ex:t2 ;
  time:hasPart ex:t3 ;
  time:hasPart ex:t4 ;
.
</skos:example>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#TemporalDuration -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalDuration">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label xml:lang="en">Temporal duration</rdfs:label>
        <skos:definition xml:lang="en">Time extent; duration of a time interval separate from its particular start position</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2006/time#Instant"/>
                    <rdf:Description rdf:about="http://www.w3.org/2006/time#Interval"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label xml:lang="en">Temporal entity</rdfs:label>
        <skos:definition xml:lang="en">A temporal interval or instant.</skos:definition>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/spatialai/stad/v2/core#ArithmeticMeanCalculation -->


    <owl:NamedIndividual rdf:about="http://purl.org/spatialai/stad/v2/core#ArithmeticMeanCalculation">
        <rdf:type rdf:resource="http://purl.org/spatialai/stad/v2/core#AverageCalculationDataTransformation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">arithmetic mean calculation</rdfs:label>
        <skos:definition xml:lang="en">A data transformation that calculates the arithmetic mean of input values.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spatialai/stad/v2/core#GeometricMeanCalculation -->


    <owl:NamedIndividual rdf:about="http://purl.org/spatialai/stad/v2/core#GeometricMeanCalculation">
        <rdf:type rdf:resource="http://purl.org/spatialai/stad/v2/core#AverageCalculationDataTransformation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">geometric mean calculation</rdfs:label>
        <skos:definition xml:lang="en">A data transformation that calculates the geometric mean of input values.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spatialai/stad/v2/core#MaximumCalculation -->


    <owl:NamedIndividual rdf:about="http://purl.org/spatialai/stad/v2/core#MaximumCalculation">
        <rdf:type rdf:resource="http://purl.org/spatialai/stad/v2/core#ExtremumCalculationDataTransformation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">maximum calculation</rdfs:label>
        <skos:definition xml:lang="en">A data transformation that returns the maximum input value.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spatialai/stad/v2/core#MedianCalculation -->


    <owl:NamedIndividual rdf:about="http://purl.org/spatialai/stad/v2/core#MedianCalculation">
        <rdf:type rdf:resource="http://purl.org/spatialai/stad/v2/core#CentralTendencyCalculationDataTransformation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">median calculation</rdfs:label>
        <skos:definition xml:lang="en">A data transformation that calculates the median of a set of values.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/spatialai/stad/v2/core#MinimumCalculation -->


    <owl:NamedIndividual rdf:about="http://purl.org/spatialai/stad/v2/core#MinimumCalculation">
