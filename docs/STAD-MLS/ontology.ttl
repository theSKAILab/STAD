#################################################################
#    Object Properties
#################################################################

###  http://purl.org/spatialai/stad/v2/core#generatedBy
<http://purl.org/spatialai/stad/v2/core#generatedBy> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint> ;
                                                     rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                                                     rdfs:label "generated by"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "Links anything that is generated by an Algorithm to the specific AlgorithmExecution that was used."@en .


###  http://purl.org/spatialai/stad/v2/core#hasTransformationKind
<http://purl.org/spatialai/stad/v2/core#hasTransformationKind> rdf:type owl:ObjectProperty ;
                                                               owl:propertyChainAxiom ( <http://purl.org/spatialai/stad/v2/core#generatedBy>
                                                                                        :realizes
                                                                                      ) ;
                                                               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                                                               rdfs:label "has transformation kind"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#definition> "Relates a statistical aggregate datapoint directly to the kind of data transformation used to produce it."@en .


###  http://purl.org/spatialai/stad/v2/core#outputOf
<http://purl.org/spatialai/stad/v2/core#outputOf> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint> ;
                                                  rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                                                  rdfs:label "output of"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a computational datapoint to the algorithm of which it is an output."@en .


###  http://purl.org/spatialai/stad/v2/mls#executes
:executes rdf:type owl:ObjectProperty ;
          rdfs:domain :AlgorithmExecution ;
          rdfs:range :Implementation ;
          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
          rdfs:label "executes"@en ;
          rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an algorithm execution to the concrete implementation executed."@en ;
          <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#executes> .


###  http://purl.org/spatialai/stad/v2/mls#hasInput
:hasInput rdf:type owl:ObjectProperty ;
          rdfs:domain :AlgorithmExecution ;
          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
          rdfs:label "has input"@en ;
          rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an algorithm execution to some input, either input data or some parameter or parameter setting."@en ;
          <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#hasInput> .


###  http://purl.org/spatialai/stad/v2/mls#hasParameter
:hasParameter rdf:type owl:ObjectProperty ;
              rdfs:domain :Implementation ;
              rdfs:range :Parameter ;
              rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
              rdfs:label "has parameter"@en ;
              rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates an implementation to a parameter it accepts."@en ;
              <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#hasHyperParameter> .


###  http://purl.org/spatialai/stad/v2/mls#implements
:implements rdf:type owl:ObjectProperty ;
            rdfs:domain :Implementation ;
            rdfs:range :Algorithm ;
            rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
            rdfs:label "implements"@en ;
            rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a concrete implementation to the algorithm it implements."@en ;
            <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#implements> .


###  http://purl.org/spatialai/stad/v2/mls#realizes
:realizes rdf:type owl:ObjectProperty ;
          rdfs:domain :AlgorithmExecution ;
          rdfs:range :Algorithm ;
          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
          rdfs:label "realizes"@en ;
          rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an algorithm execution to the algorithm realized by that execution."@en ;
          <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#realizes> .


###  http://purl.org/spatialai/stad/v2/mls#specifiedBy
:specifiedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :ParameterSetting ;
             rdfs:range :Parameter ;
             rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
             rdfs:label "specified by"@en ;
             rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a parameter setting to the parameter whose value it specifies."@en ;
             <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#specifiedBy> .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/spatialai/stad/v2/mls#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
          rdfs:domain :ParameterSetting ;
          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
          rdfs:label "has value"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a parameter setting to its literal value."@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint
<http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint> rdf:type owl:Class ;
                                                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://purl.org/spatialai/stad/v2/core#generatedBy> ;
                                                                                  owl:allValuesFrom :AlgorithmExecution
                                                                                ] ;
                                                                rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                                                                rdfs:label "computational datapoint"@en ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "A datapoint generated by one algorithm execution from one or more base datapoints or datasets."@en .


###  http://purl.org/spatialai/stad/v2/core#DataTransformation
<http://purl.org/spatialai/stad/v2/core#DataTransformation> rdf:type owl:Class ;
                                                            rdfs:subClassOf :Algorithm ;
                                                            rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                                                            rdfs:label "data transformation"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "An algorithm that manipulates or converts data from one form into another, including filtering, sorting, aggregation, type conversion, or mathematical operations."@en .


###  http://purl.org/spatialai/stad/v2/core#Dataset
<http://purl.org/spatialai/stad/v2/core#Dataset> rdf:type owl:Class ;
                                                 rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core#> ;
                                                 rdfs:label "dataset"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "A collection of datapoints that has an associated dataset description."@en .


###  http://purl.org/spatialai/stad/v2/mls#Algorithm
:Algorithm rdf:type owl:Class ;
           rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
           rdfs:label "algorithm"@en ;
           rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
           <http://www.w3.org/2004/02/skos/core#definition> "A sequential set of instructions for solving a problem or achieving a goal, independent of a concrete implementation or execution."@en ;
           <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#Algorithm> .


###  http://purl.org/spatialai/stad/v2/mls#AlgorithmExecution
:AlgorithmExecution rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasInput ;
                                      owl:someValuesFrom <http://purl.org/spatialai/stad/v2/core#Dataset>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasInput ;
                                      owl:someValuesFrom :ParameterSetting
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :realizes ;
                                      owl:someValuesFrom :Algorithm
                                    ] ;
                    rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
                    rdfs:label "algorithm execution"@en ;
                    rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A specific run of an implementation of an algorithm, using particular inputs and parameter settings."@en ;
                    <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#Run> .


###  http://purl.org/spatialai/stad/v2/mls#Implementation
:Implementation rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasParameter ;
                                  owl:someValuesFrom :Parameter
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :implements ;
                                  owl:someValuesFrom :Algorithm
                                ] ;
                rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
                rdfs:label "implementation"@en ;
                rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
                <http://www.w3.org/2004/02/skos/core#definition> "An executable realization of an algorithm in a particular programming language or software environment."@en ;
                <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#Implementation> .


###  http://purl.org/spatialai/stad/v2/mls#Parameter
:Parameter rdf:type owl:Class ;
           rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
           rdfs:label "parameter"@en ;
           rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
           <http://www.w3.org/2004/02/skos/core#definition> "A named input accepted by an implementation and assigned a value in a parameter setting."@en ;
           <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#HyperParameter> .


###  http://purl.org/spatialai/stad/v2/mls#ParameterSetting
:ParameterSetting rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :specifiedBy ;
                                    owl:someValuesFrom :Parameter
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasValue ;
                                    owl:someValuesFrom rdfs:Literal
                                  ] ;
                  rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/mls#> ;
                  rdfs:label "parameter setting"@en ;
                  rdfs:seeAlso "http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf"^^xsd:anyURI ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An assignment of a literal value to a parameter for a particular algorithm execution."@en ;
                  <http://www.w3.org/2004/02/skos/core#related> <http://www.w3.org/ns/mls#HyperParameterSetting> .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Algorithm
                :AlgorithmExecution
                :Implementation
                :Parameter
                :ParameterSetting
              )
] .


