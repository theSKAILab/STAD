<http://purl.org/spatialai/stad/v2/mls#> rdf:type owl:Ontology ;
                                          owl:versionIRI <http://purl.org/spatialai/stad/v2/mls#> ;
                                          <http://purl.org/dc/terms/created> "2025-11-16"^^xsd:date ;
                                          <http://purl.org/dc/terms/creator> "Kingsley Wiafe-Kwakye - https://orcid.org/0009-0007-3741-3721"@en ,
                                                                             "Torsten Hahmann - http://orcid.org/0000-0002-5331-5052"@en ;
                                          <http://purl.org/dc/terms/description> "STAD provides syntax for describing the spatial and temporal characteristics of aggregate quantities. This extension includes concepts for describing the algorithms and implementations used for data transformations. It is based on the Machine Learning Schema (MLS)."@en ;
                                          <http://purl.org/dc/terms/identifier> "http://purl.org/spatialai/stad/v2/mls>"@en ;
                                          <http://purl.org/dc/terms/issued> "2026-09-09"^^xsd:date ;
                                          <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                          <http://purl.org/dc/terms/modified> "2026-09-09"^^xsd:date ;
                                          <http://purl.org/dc/terms/publisher> "Spatial Knowledge and Artificial Intelligence (SKAI) Lab, University of Maine"@en ;
                                          <http://purl.org/dc/terms/subject> "Aggregate data" ,
                                                                             "Data transformation" ,
                                                                             "Spatial aggregate data" ,
                                                                             "Temporal aggregate data" ;
                                          <http://purl.org/dc/terms/title> "Spatial and Temporal Aggregate Data Ontology MLS extension (STAD-MLS)"@en ;
                                          rdfs:label "STAD-MLS extension"@en ;
                                          owl:versionInfo "1.0"@en .

