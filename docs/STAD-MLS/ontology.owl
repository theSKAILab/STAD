        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/mls#"/>
        <rdfs:label xml:lang="en">has input</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf</rdfs:seeAlso>
        <skos:definition xml:lang="en">Relates an algorithm execution to some input, either input data or some parameter or parameter setting.</skos:definition>
        <skos:related rdf:resource="http://www.w3.org/ns/mls#hasInput"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/mls#hasParameter -->


