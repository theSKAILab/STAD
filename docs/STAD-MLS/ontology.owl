            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/mls#realizes"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/mls#Algorithm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/mls#"/>
        <rdfs:label xml:lang="en">algorithm execution</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf</rdfs:seeAlso>
        <skos:definition xml:lang="en">A specific run of an implementation of an algorithm, using particular inputs and parameter settings.</skos:definition>
        <skos:related rdf:resource="http://www.w3.org/ns/mls#Run"/>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/mls#Implementation -->


