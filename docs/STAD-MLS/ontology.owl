        <rdfs:label xml:lang="en">algorithm</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf</rdfs:seeAlso>
        <skos:definition xml:lang="en">A sequential set of instructions for solving a problem or achieving a goal, independent of a concrete implementation or execution.</skos:definition>
        <skos:related rdf:resource="http://www.w3.org/ns/mls#Algorithm"/>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/mls#AlgorithmExecution -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/mls#AlgorithmExecution">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/mls#hasInput"/>
