    <owl:Ontology rdf:about="http://purl.org/spatialai/stad/v2/mls#">
        <owl:versionIRI rdf:resource="http://purl.org/spatialai/stad/v2/mls#"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-16</terms:created>
        <terms:creator xml:lang="en">Kingsley Wiafe-Kwakye - https://orcid.org/0009-0007-3741-3721</terms:creator>
        <terms:creator xml:lang="en">Torsten Hahmann - http://orcid.org/0000-0002-5331-5052</terms:creator>
        <terms:description xml:lang="en">STAD provides syntax for describing the spatial and temporal characteristics of aggregate quantities. This extension includes concepts for describing the algorithms and implementations used for data transformations. It is based on the Machine Learning Schema (MLS).</terms:description>
        <terms:identifier xml:lang="en">http://purl.org/spatialai/stad/v2/mls&gt;</terms:identifier>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-09</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-09</terms:modified>
        <terms:publisher xml:lang="en">Spatial Knowledge and Artificial Intelligence (SKAI) Lab, University of Maine</terms:publisher>
        <terms:subject>Aggregate data</terms:subject>
        <terms:subject>Data transformation</terms:subject>
        <terms:subject>Spatial aggregate data</terms:subject>
        <terms:subject>Temporal aggregate data</terms:subject>
        <terms:title xml:lang="en">Spatial and Temporal Aggregate Data Ontology MLS extension (STAD-MLS)</terms:title>
        <rdfs:label xml:lang="en">STAD-MLS extension</rdfs:label>
        <owl:versionInfo xml:lang="en">1.0</owl:versionInfo>
    </owl:Ontology>
    


