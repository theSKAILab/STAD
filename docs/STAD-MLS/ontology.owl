        <skos:definition xml:lang="en">Relates an implementation to a parameter it accepts.</skos:definition>
        <skos:related rdf:resource="http://www.w3.org/ns/mls#hasHyperParameter"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/mls#implements -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/mls#implements">
