        <rdfs:label xml:lang="en">implements</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf</rdfs:seeAlso>
        <skos:definition xml:lang="en">Relates a concrete implementation to the algorithm it implements.</skos:definition>
        <skos:related rdf:resource="http://www.w3.org/ns/mls#implements"/>
