    <!-- http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/spatialai/stad/v2/core#generatedBy"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/spatialai/stad/v2/mls#AlgorithmExecution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">computational datapoint</rdfs:label>
        <skos:definition xml:lang="en">A datapoint generated by one algorithm execution from one or more base datapoints or datasets.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#DataTransformation -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#DataTransformation">
        <rdfs:subClassOf rdf:resource="http://purl.org/spatialai/stad/v2/mls#Algorithm"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">data transformation</rdfs:label>
        <skos:definition xml:lang="en">An algorithm that manipulates or converts data from one form into another, including filtering, sorting, aggregation, type conversion, or mathematical operations.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/core#Dataset -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/core#Dataset">
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/core#"/>
        <rdfs:label xml:lang="en">dataset</rdfs:label>
        <skos:definition xml:lang="en">A collection of datapoints that has an associated dataset description.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/spatialai/stad/v2/mls#Algorithm -->


    <owl:Class rdf:about="http://purl.org/spatialai/stad/v2/mls#Algorithm">
