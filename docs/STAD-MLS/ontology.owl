        <rdfs:isDefinedBy rdf:resource="http://purl.org/spatialai/stad/v2/mls#"/>
        <rdfs:label xml:lang="en">executes</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://ontologydesignpatterns.org/wiki/images/4/41/WOP2016_paper_07.pdf</rdfs:seeAlso>
        <skos:definition xml:lang="en">Relates an algorithm execution to the concrete implementation executed.</skos:definition>
        <skos:related rdf:resource="http://www.w3.org/ns/mls#executes"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spatialai/stad/v2/mls#hasInput -->


    <owl:ObjectProperty rdf:about="http://purl.org/spatialai/stad/v2/mls#hasInput">
