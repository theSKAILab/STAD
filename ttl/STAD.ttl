@prefix : <http://purl.org/spatialai/stad/v2/core/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix greg: <http://www.w3.org/ns/time/gregorian#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stad: <http://purl.org/spatialai/stad/v2/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://purl.org/spatialai/stad/v2/core/> .

<http://purl.org/spatialai/stad/v2/core/> rdf:type owl:Ontology ;
                                           owl:versionIRI <http://purl.org/spatialai/stad/v2/core> ;
                                           owl:imports <http://www.w3.org/2006/time> ,
		<https://raw.githubusercontent.com/w3c/sdw/gh-pages/time-aggregates/rdf/time-agg.ttl> ;
											rdfs:label "STAD Ontology"@en  ;
                                           dcterms:created "2025-11-16"^^xsd:date ;
                                           dcterms:creator "Kate Beard - https://orcid.org/0000-0002-7703-0270"@en ,
                                                           "Kingsley Wiafe-Kwakye - https://orcid.org/0009-0007-3741-3721"@en ,
                                                           "Torsten Hahmann - http://orcid.org/0000-0002-5331-5052"@en ;
                                           dcterms:description "STAD provides syntax for describing the spatial and temporal characteristics of aggregate quantities."@en ;
                                           dcterms:identifier "http://purl.org/spatialai/stad/v2/core>"@en ;
                                           dcterms:issued "2025-11-16"^^xsd:date ;
                                           dcterms:license "This work is distributed under a Creative Commons Attribution License (https://creativecommons.org/licenses/by/4.0/)."@en ;
                                           dcterms:modified "2026-09-09"^^xsd:date ;
                                           dcterms:publisher "Spatial Knowledge and Artificial Intelligence (SKAI) Lab, University of Maine"@en ;
                                           dcterms:subject "Aggregate data" ,
                                                           "Spatial aggregate data" ,
                                                           "Temporal aggregate data" ;
                                           dcterms:title "Spatial and Temporal Aggregate Data (STAD) Ontology"@en ;
                                           owl:versionInfo "2.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
dcterms:issued rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/subject
dcterms:subject rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#editorialNote
skos:editorialNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#related
skos:related rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/hasPart
dcterms:hasPart rdf:type owl:ObjectProperty .


###  http://purl.org/spatialai/stad/v2/core#containsDatapoint
stad:containsDatapoint rdf:type owl:ObjectProperty ;
                       rdfs:domain stad:Dataset ;
                       rdfs:range stad:Datapoint ;
                       rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                       rdfs:label "contains datapoint"@en ;
                       skos:definition "Relates a dataset to a datapoint contained in that dataset."@en .


###  http://purl.org/spatialai/stad/v2/core#generatedBy
stad:generatedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain stad:ComputationalDatapoint ;
                 rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                 rdfs:label "generated by"@en ;
                 skos:definition "Links anything that is generated by an Algorithm to the specific AlgorithmExecution that was used."@en .


###  http://purl.org/spatialai/stad/v2/core#hasAggregationPeriod
stad:hasAggregationPeriod rdf:type owl:ObjectProperty ;
                          rdfs:domain stad:StatisticalAggregateDatapoint ;
                          rdfs:range stad:AggregationPeriod ;
                          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                          rdfs:label "has aggregation period"@en ;
                          skos:definition "Relates a statistical aggregate datapoint to the temporal entities over which its base data were selected for aggregation."@en .


###  http://purl.org/spatialai/stad/v2/core#hasBaseDatapoint
stad:hasBaseDatapoint rdf:type owl:ObjectProperty ;
                      rdfs:domain stad:ComputationalDatapoint ;
                      rdfs:range stad:Datapoint ;
                      owl:propertyChainAxiom ( stad:hasBaseDataset
                                               stad:containsDatapoint
                                             ) ;
                      rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                      rdfs:label "has base datapoint"@en ;
                      skos:definition "Relates a computational datapoint to a datapoint used to compute it; this relation can be inferred through its base dataset."@en .


###  http://purl.org/spatialai/stad/v2/core#hasBaseDataset
stad:hasBaseDataset rdf:type owl:ObjectProperty ;
                    rdfs:domain stad:ComputationalDatapoint ;
                    rdfs:range stad:Dataset ;
                    rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                    rdfs:label "has base dataset"@en ;
                    skos:definition "Relates a computational datapoint to a dataset used to compute it."@en .


###  http://purl.org/spatialai/stad/v2/core#hasConvexAggregationPeriod
stad:hasConvexAggregationPeriod rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf stad:hasAggregationPeriod ;
                                rdfs:range stad:ConvexAggregationPeriod ;
                                rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                rdfs:label "has convex aggregation period"@en ;
                                skos:definition "Relates an aggregate datapoint to a convex aggregation period."@en .


###  http://purl.org/spatialai/stad/v2/core#hasDataValue
stad:hasDataValue rdf:type owl:ObjectProperty ;
                  rdfs:domain stad:Datapoint ;
                  rdfs:range stad:DataValue ;
                  rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                  rdfs:label "has data value"@en ;
                  skos:definition "Relates a datapoint to the value it carries."@en .


###  http://purl.org/spatialai/stad/v2/core#hasDatasetDescription
stad:hasDatasetDescription rdf:type owl:ObjectProperty ;
                           rdfs:domain stad:Dataset ;
                           rdfs:range stad:DatasetDescription ;
                           rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                           rdfs:label "has dataset description"@en ;
                           skos:definition "Relates a dataset to a description of characteristics such as its spatial and temporal resolution."@en .


###  http://purl.org/spatialai/stad/v2/core#hasExtent
stad:hasExtent rdf:type owl:ObjectProperty ;
               owl:inverseOf stad:isExtentOf ;
               rdfs:domain stad:AggregationPeriod ;
               rdfs:range time:Interval ;
               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
               rdfs:label "has extent"@en ;
               skos:definition "Relates an aggregation period to the single proper interval forming its minimal convex temporal extent."@en .


###  http://purl.org/spatialai/stad/v2/core#hasInput
stad:hasInput rdf:type owl:ObjectProperty ;
              rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
              rdfs:label "has input"@en ;
              skos:definition "Relates an algorithm execution to an input dataset."@en .


###  http://purl.org/spatialai/stad/v2/core#hasInstant
stad:hasInstant rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf time:hasPart ;
                owl:inverseOf stad:instantPartOf ;
                rdfs:range time:Instant ;
                rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                rdfs:label "has instant"@en ;
                skos:definition "Relates a temporal aggregate to an instant that is one of its temporal parts."@en .


###  http://purl.org/spatialai/stad/v2/core#hasInterval
stad:hasInterval rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf time:hasPart ;
                 owl:inverseOf stad:intervalPartOf ;
                 rdfs:range time:Interval ;
                 rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                 rdfs:label "has interval"@en ;
                 skos:definition "Relates a temporal aggregate to an interval that is one of its temporal parts."@en .


###  http://purl.org/spatialai/stad/v2/core#hasNonConvexAggregationPeriod
stad:hasNonConvexAggregationPeriod rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf stad:hasAggregationPeriod ;
                                   rdfs:range stad:NonConvexAggregationPeriod ;
                                   rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                   rdfs:label "has non-convex aggregation period"@en ;
                                   skos:definition "Relates an aggregate datapoint to a non-convex aggregation period."@en .


###  http://purl.org/spatialai/stad/v2/core#hasQualitativeValue
stad:hasQualitativeValue rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf stad:hasDataValue ;
                         rdfs:domain stad:QualitativeDatapoint ;
                         rdfs:range stad:QualitativeValue ;
                         rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                         rdfs:label "has qualitative value"@en ;
                         skos:definition "Relates a qualitative datapoint to its qualitative value."@en .


###  http://purl.org/spatialai/stad/v2/core#hasQualityKind
stad:hasQualityKind rdf:type owl:ObjectProperty ;
                    rdfs:domain stad:Datapoint ;
                    rdfs:range stad:QualityKind ;
                    rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                    rdfs:label "has quality kind"@en ;
                    skos:definition "Relates a datapoint to the quality or property kind whose value it represents."@en .


###  http://purl.org/spatialai/stad/v2/core#hasQuantitativeValue
stad:hasQuantitativeValue rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf stad:hasDataValue ;
                          rdfs:domain stad:QuantitativeDatapoint ;
                          rdfs:range stad:QuantitativeValue ;
                          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                          rdfs:label "has quantitative value"@en ;
                          skos:definition "Relates a quantitative datapoint to its quantitative value."@en .


###  http://purl.org/spatialai/stad/v2/core#hasSpatialCoverage
stad:hasSpatialCoverage rdf:type owl:ObjectProperty ;
                        owl:inverseOf stad:spatialCoverageOf ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( stad:Dataset
                                                    stad:SpatialAggregateDatapoint
                                                  )
                                    ] ;
                        rdfs:range stad:SpatialCoverage ;
                        rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                        rdfs:label "has spatial coverage"@en ;
                        skos:definition "Relates a dataset or spatial aggregate datapoint to the spatial extent it covers or summarizes."@en .


###  http://purl.org/spatialai/stad/v2/core#hasSpatialResolution
stad:hasSpatialResolution rdf:type owl:ObjectProperty ;
                          rdfs:domain stad:DatasetDescription ;
                          rdfs:range stad:SpatialResolution ;
                          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                          rdfs:label "has spatial resolution"@en ;
                          skos:definition "Relates a dataset description to a descriptor of the dataset's spatial resolution."@en ;
                          skos:note "No maximum cardinality is imposed because a dataset may report multiple complementary spatial resolution measures."@en .


###  http://purl.org/spatialai/stad/v2/core#hasTemporalCoverage
stad:hasTemporalCoverage rdf:type owl:ObjectProperty ;
                         owl:inverseOf stad:temporalCoverageOf ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( stad:Dataset
                                                     stad:StatisticalAggregateDatapoint
                                                   )
                                     ] ;
                         rdfs:range stad:TemporalCoverage ;
                         rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                         rdfs:label "has temporal coverage"@en ;
                         skos:definition "Relates a dataset or statistical aggregate datapoint to the overall interval covered by its data."@en .


###  http://purl.org/spatialai/stad/v2/core#hasTemporalPart
stad:hasTemporalPart rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf time:hasPart ;
                     rdfs:domain time:TemporalAggregate ;
                     rdfs:range time:TemporalEntity ;
                     owl:propertyChainAxiom ( stad:hasConvexAggregationPeriod
                                              stad:hasExtent
                                            ) ;
                     rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                     rdfs:label "has a temporal part (STAD relation)" ;
                     skos:definition "Relates a temporal aggregate to one of its constituent temporal entities, including an inferred extent for a convex aggregation period."@en .


###  http://purl.org/spatialai/stad/v2/core#hasTemporalResolution
stad:hasTemporalResolution rdf:type owl:ObjectProperty ;
                           rdfs:domain stad:DatasetDescription ;
                           rdfs:range stad:TemporalResolution ;
                           rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                           rdfs:label "has temporal resolution"@en ;
                           skos:definition "Relates a dataset description to a descriptor of the dataset's temporal resolution."@en .


###  http://purl.org/spatialai/stad/v2/core#hasTransformationKind
stad:hasTransformationKind rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf stad:outputOf ;
                           rdfs:domain stad:StatisticalAggregateDatapoint ;
                           rdfs:range stad:DataTransformation ;
                           rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                           rdfs:label "has transformation kind"@en ;
                           skos:definition "Relates a statistical aggregate datapoint directly to the kind of data transformation used to produce it."@en .


###  http://purl.org/spatialai/stad/v2/core#instantPartOf
stad:instantPartOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf time:isPartOf ;
                   rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                   rdfs:label "instant part of"@en ;
                   skos:definition "Relates an instant to the temporal aggregate of which it is a part."@en .


###  http://purl.org/spatialai/stad/v2/core#intervalPartOf
stad:intervalPartOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf time:isPartOf ;
                    rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                    rdfs:label "interval part of"@en ;
                    skos:definition "Relates an interval to the temporal aggregate of which it is a part."@en .


###  http://purl.org/spatialai/stad/v2/core#isConvexAggregationPeriod
stad:isConvexAggregationPeriod rdf:type owl:ObjectProperty ;
                               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                               rdfs:label "is convex aggregation period"@en ;
                               skos:definition "Indicates that a resource is associated with a convex aggregation period."@en .


###  http://purl.org/spatialai/stad/v2/core#isExtentOf
stad:isExtentOf rdf:type owl:ObjectProperty ;
                rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                rdfs:label "is extent of"@en ;
                skos:definition "Relates a temporal interval to the aggregation period for which it is the minimal convex extent."@en .


###  http://purl.org/spatialai/stad/v2/core#outputOf
stad:outputOf rdf:type owl:ObjectProperty ;
              rdfs:domain stad:ComputationalDatapoint ;
              rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
              rdfs:label "output of"@en ;
              skos:definition "Relates a computational datapoint to the algorithm of which it is an output."@en .


###  http://purl.org/spatialai/stad/v2/core#spatialCoverageOf
stad:spatialCoverageOf rdf:type owl:ObjectProperty ;
                       rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                       rdfs:label "spatial coverage of"@en ;
                       skos:definition "Relates a spatial coverage to a dataset or spatial aggregate datapoint that it covers; inverse of has spatial coverage."@en .


###  http://purl.org/spatialai/stad/v2/core#temporalCoverageOf
stad:temporalCoverageOf rdf:type owl:ObjectProperty ;
                        rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                        rdfs:label "temporal coverage of"@en ;
                        skos:definition "Relates a temporal coverage to a dataset or statistical aggregate datapoint that it covers; inverse of has temporal coverage."@en .


###  http://www.opengis.net/ont/geosparql#hasGeometry
geo:hasGeometry rdf:type owl:ObjectProperty ;
                rdfs:domain geo:Feature ;
                rdfs:range geo:Geometry ;
                rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#> ;
                rdfs:label "has geometry"@en ;
                skos:definition "A spatial representation for a given Feature."@en ;
                skos:prefLabel "has geometry"@en .


###  http://www.w3.org/2000/01/rdf-schema#member
rdfs:member rdf:type owl:ObjectProperty .


###  http://www.w3.org/2006/time#hasBeginning
time:hasBeginning rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf time:hasTime ;
                  rdfs:domain time:TemporalEntity ;
                  rdfs:range time:Instant ;
                  rdfs:comment "Beginning of a temporal entity"@en ;
                  rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                  rdfs:label "has beginning"@en ;
                  skos:definition "Beginning of a temporal entity."@en .


###  http://www.w3.org/2006/time#hasEnd
time:hasEnd rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf time:hasTime ;
            rdfs:domain time:TemporalEntity ;
            rdfs:range time:Instant ;
            rdfs:comment "End of a temporal entity."@en ;
            rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
            rdfs:label "has end"@en ;
            skos:definition "End of a temporal entity."@en .


###  http://www.w3.org/2006/time#hasPart
time:hasPart rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf dcterms:hasPart ,
                                rdfs:member ;
             owl:inverseOf time:isPartOf ;
             rdfs:domain time:TemporalAggregate ;
             rdfs:range time:TemporalEntity ;
             rdfs:comment "Link to a temporal aggregate of which this temporal entity is a part" ,
                          "Link to a temporal entity that is a part of this temporal aggregate" ;
             rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
             rdfs:label "has a part" ;
             skos:definition "Relates a temporal aggregate to a constituent temporal entity."@en ;
             skos:example """
ex:VicSchoolTerms2020
  a time:TemporalAggregate ;
  time:hasPart ex:t1 ;
.
ex:t1
  a time:ProperInterval ;
.
""" .


###  http://www.w3.org/2006/time#hasTime
time:hasTime rdf:type owl:ObjectProperty ;
             rdfs:range time:TemporalEntity ;
             rdfs:comment "Supports the association of a temporal entity (instant or interval) to any thing"@en ;
             rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
             rdfs:label "has time"@en ;
             skos:definition "Supports the association of a temporal entity (instant or interval) to any thing"@en ;
             skos:editorialNote "Feature at risk - added in 2017 revision, and not yet widely used. "@en .


###  http://www.w3.org/2006/time#isPartOf
time:isPartOf rdf:type owl:ObjectProperty ;
              rdfs:domain time:TemporalEntity ;
              rdfs:range time:TemporalAggregate ;
              rdfs:comment "Link to a temporal aggregate of which this temporal entity is a part" ;
              rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
              rdfs:label "is a part of" ;
              skos:definition "Relates a temporal entity to a temporal aggregate of which it is a part."@en ;
              skos:example """
ex:t1
  a time:ProperInterval ;
  time:isPartOf ex:VicSchoolTerms2020 ;
.
ex:VicSchoolTerms2020
  a time:TemporalAggregate ;
.
""" .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/spatialai/stad/v2/core#hasValue
stad:hasValue rdf:type owl:DatatypeProperty ;
              rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
              rdfs:label "has value"@en ;
              skos:definition "Relates a parameter setting to its literal value."@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/spatialai/stad/v2/core#AggregationPeriod
stad:AggregationPeriod rdf:type owl:Class ;
                       rdfs:subClassOf time:TemporalAggregate ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty time:hasPart ;
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass time:TemporalEntity
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty stad:hasExtent ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass time:ProperInterval
                                       ] ;
                       rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                       rdfs:label "aggregation period"@en ;
                       skos:definition "A temporal aggregate comprising the temporal entities over which base data were selected for an aggregation, together with one minimal convex extent."@en .


###  http://purl.org/spatialai/stad/v2/core#AverageCalculationDataTransformation
stad:AverageCalculationDataTransformation rdf:type owl:Class ;
                                          rdfs:subClassOf stad:CentralTendencyCalculationDataTransformation ;
                                          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                          rdfs:label "average calculation data transformation"@en ;
                                          skos:definition "A data transformation that calculates an average of input values."@en .


###  http://purl.org/spatialai/stad/v2/core#CentralTendencyCalculationDataTransformation
stad:CentralTendencyCalculationDataTransformation rdf:type owl:Class ;
                                                  rdfs:subClassOf stad:DataTransformation ;
                                                  rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                                  rdfs:label "central tendency calculation data transformation"@en ;
                                                  skos:definition "A data transformation that calculates a measure representing the center or typical value of a set of values."@en .


###  http://purl.org/spatialai/stad/v2/core#ComputationalDatapoint
stad:ComputationalDatapoint rdf:type owl:Class ;
                            rdfs:subClassOf stad:Datapoint ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty stad:hasBaseDatapoint ;
                                              owl:allValuesFrom stad:Datapoint
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty stad:hasBaseDataset ;
                                              owl:allValuesFrom stad:Dataset
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty stad:generatedBy ;
                                              owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                            ] ;
                            owl:disjointWith stad:ObservationalDatapoint ;
                            rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                            rdfs:label "computational datapoint"@en ;
                            skos:definition "A datapoint generated by one algorithm execution from one or more base datapoints or datasets."@en .


###  http://purl.org/spatialai/stad/v2/core#ComputationalPredictedDatapoint
stad:ComputationalPredictedDatapoint rdf:type owl:Class ;
                                     rdfs:subClassOf stad:ComputationalDatapoint ;
                                     owl:disjointWith stad:StatisticalAggregateDatapoint ;
                                     rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                     rdfs:label "computational predicted datapoint"@en ;
                                     skos:definition "A computational datapoint whose value is predicted rather than obtained as a statistical aggregate."@en .


###  http://purl.org/spatialai/stad/v2/core#ConvexAggregationPeriod
stad:ConvexAggregationPeriod rdf:type owl:Class ;
                             rdfs:subClassOf stad:AggregationPeriod ;
                             owl:disjointWith stad:NonConvexAggregationPeriod ;
                             rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                             rdfs:label "convex aggregation period"@en ;
                             skos:definition "An aggregation period consisting of a single continuous temporal part that matches its overall extent."@en .


###  http://purl.org/spatialai/stad/v2/core#CoverageRatioResolution
stad:CoverageRatioResolution rdf:type owl:Class ;
                             rdfs:subClassOf stad:SpatialResolution ;
                             rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                             rdfs:label "coverage ratio resolution"@en ;
                             skos:definition "A spatial resolution expressed as the ratio of the area represented by observations to the total study area."@en ;
                             skos:note "The method used to determine the area represented by observations should be specified when it is not determined directly by raster cells or explicit sampling units."@en .


###  http://purl.org/spatialai/stad/v2/core#Data
stad:Data rdf:type owl:Class ;
          rdfs:subClassOf stad:InformationEntity ;
          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
          rdfs:label "data"@en ;
          skos:definition "An information entity that represents data."@en .


###  http://purl.org/spatialai/stad/v2/core#DataTransformation
stad:DataTransformation rdf:type owl:Class ;
                        rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                        rdfs:label "data transformation"@en ;
                        skos:definition "An algorithm that manipulates or converts data from one form into another, including filtering, sorting, aggregation, type conversion, or mathematical operations."@en .


###  http://purl.org/spatialai/stad/v2/core#DataValue
stad:DataValue rdf:type owl:Class ;
               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
               rdfs:label "data value"@en ;
               skos:definition "A value carried by a datapoint."@en .


###  http://purl.org/spatialai/stad/v2/core#Datapoint
stad:Datapoint rdf:type owl:Class ;
               rdfs:subClassOf stad:Data ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty stad:hasDataValue ;
                                 owl:someValuesFrom stad:DataValue
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty stad:hasQualityKind ;
                                 owl:someValuesFrom stad:QualityKind
                               ] ;
               owl:disjointWith stad:Dataset ;
               rdfs:comment "super class for all data point categories"@en ;
               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
               rdfs:label "datapoint"@en ;
               skos:definition "An individual data item that has a quality kind and a corresponding data value."@en .


###  http://purl.org/spatialai/stad/v2/core#Dataset
stad:Dataset rdf:type owl:Class ;
             rdfs:subClassOf stad:Data ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty stad:containsDatapoint ;
                               owl:someValuesFrom stad:Datapoint
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty stad:hasDatasetDescription ;
                               owl:someValuesFrom stad:DatasetDescription
                             ] ;
             rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
             rdfs:label "dataset"@en ;
             skos:definition "A collection of datapoints that has an associated dataset description."@en .


###  http://purl.org/spatialai/stad/v2/core#DatasetDescription
stad:DatasetDescription rdf:type owl:Class ;
                        rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                        rdfs:label "dataset description"@en ;
                        skos:definition "A description of dataset-level characteristics, including spatial and temporal resolution."@en .


###  http://purl.org/spatialai/stad/v2/core#ExtremumCalculationDataTransformation
stad:ExtremumCalculationDataTransformation rdf:type owl:Class ;
                                           rdfs:subClassOf stad:DataTransformation ;
                                           rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                           rdfs:label "extremum calculation data transformation"@en ;
                                           skos:definition "A data transformation that calculates an extreme value, such as a minimum or maximum."@en .


###  http://purl.org/spatialai/stad/v2/core#InformationEntity
stad:InformationEntity rdf:type owl:Class ;
                       rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                       rdfs:label "information entity"@en ;
                       skos:definition "An entity whose identity and content are informational."@en .


###  http://purl.org/spatialai/stad/v2/core#NonConvexAggregationPeriod
stad:NonConvexAggregationPeriod rdf:type owl:Class ;
                                rdfs:subClassOf stad:AggregationPeriod ;
                                rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                rdfs:label "non-convex aggregation period"@en ;
                                skos:definition "An aggregation period composed of multiple disconnected temporal parts."@en .


###  http://purl.org/spatialai/stad/v2/core#ObservationalDatapoint
stad:ObservationalDatapoint rdf:type owl:Class ;
                            rdfs:subClassOf stad:Datapoint ;
                            rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                            rdfs:label "observational datapoint"@en ;
                            skos:definition "A datapoint obtained through observation rather than computation."@en .


###  http://purl.org/spatialai/stad/v2/core#PixelSizeResolution
stad:PixelSizeResolution rdf:type owl:Class ;
                         rdfs:subClassOf stad:SpatialResolution ;
                         rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                         rdfs:label "pixel size resolution"@en ;
                         skos:definition "A spatial resolution expressed by the ground dimensions of a raster or grid cell."@en .


###  http://purl.org/spatialai/stad/v2/core#PointSpacingResolution
stad:PointSpacingResolution rdf:type owl:Class ;
                            rdfs:subClassOf stad:SpatialResolution ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty stad:hasTransformationKind ;
                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                            ] ;
                            rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                            rdfs:label "point spacing resolution"@en ;
                            skos:definition "A spatial resolution expressed by a statistical summary of distances between neighboring sampling locations in non-gridded spatial data."@en ;
                            skos:note "The method used to identify neighboring datapoints should be specified when it is not evident from the sampling design."@en .


###  http://purl.org/spatialai/stad/v2/core#QualitativeDatapoint
stad:QualitativeDatapoint rdf:type owl:Class ;
                          rdfs:subClassOf stad:Datapoint ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty stad:hasQualitativeValue ;
                                            owl:someValuesFrom stad:QualitativeValue
                                          ] ;
                          owl:disjointWith stad:QuantitativeDatapoint ;
                          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                          rdfs:label "qualitative datapoint"@en ;
                          skos:definition "A datapoint whose value is qualitative, such as a category or class."@en .


###  http://purl.org/spatialai/stad/v2/core#QualitativeValue
stad:QualitativeValue rdf:type owl:Class ;
                      rdfs:subClassOf stad:DataValue ;
                      owl:disjointWith stad:QuantitativeValue ;
                      rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                      rdfs:label "qualitative value"@en ;
                      skos:definition "A non-numerical data value, such as a categorical value."@en .


###  http://purl.org/spatialai/stad/v2/core#QualityKind
stad:QualityKind rdf:type owl:Class ;
                 rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                 rdfs:label "quality kind"@en ;
                 skos:definition "The kind of quality or property represented by a datapoint, distinct from the value of that quality."@en .


###  http://purl.org/spatialai/stad/v2/core#QuantitativeDatapoint
stad:QuantitativeDatapoint rdf:type owl:Class ;
                           rdfs:subClassOf stad:Datapoint ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty stad:hasQuantitativeValue ;
                                             owl:someValuesFrom stad:QuantitativeValue
                                           ] ;
                           rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                           rdfs:label "quantitative datapoint"@en ;
                           skos:definition "A datapoint whose value is quantitative."@en .


###  http://purl.org/spatialai/stad/v2/core#QuantitativeValue
stad:QuantitativeValue rdf:type owl:Class ;
                       rdfs:subClassOf stad:DataValue ;
                       rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                       rdfs:label "quantitative value"@en ;
                       skos:definition "A numerical data value, typically represented with a numeric value and unit."@en .


###  http://purl.org/spatialai/stad/v2/core#RegularTemporalResolution
stad:RegularTemporalResolution rdf:type owl:Class ;
                               rdfs:subClassOf stad:TemporalResolution ;
                               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                               rdfs:label "regular temporal resolution"@en ;
                               skos:definition "A temporal resolution expressed by the constant or nominal interval between successive observations."@en .


###  http://purl.org/spatialai/stad/v2/core#ResolutionDescriptor
stad:ResolutionDescriptor rdf:type owl:Class ;
                          rdfs:subClassOf stad:QuantitativeDatapoint ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty stad:hasQuantitativeValue ;
                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                          ] ;
                          rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                          rdfs:label "resolution descriptor"@en ;
                          skos:definition "A description of the spatial or temporal granularity at which data in a dataset are represented or distinguished."@en .


###  http://purl.org/spatialai/stad/v2/core#SamplingDensityResolution
stad:SamplingDensityResolution rdf:type owl:Class ;
                               rdfs:subClassOf stad:SpatialResolution ;
                               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                               rdfs:label "sampling density resolution"@en ;
                               skos:definition "A spatial resolution expressed as the number of datapoints or sampling locations per unit area."@en .


###  http://purl.org/spatialai/stad/v2/core#SpatialAggregateDatapoint
stad:SpatialAggregateDatapoint rdf:type owl:Class ;
                               rdfs:subClassOf stad:StatisticalAggregateDatapoint ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty stad:hasSpatialCoverage ;
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                               ] ;
                               rdfs:comment "All quantities that are aggregated over space"@en ;
                               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                               rdfs:label "spatial aggregate datapoint"@en ;
                               skos:definition "A statistical aggregate datapoint computed over a spatial extent and having exactly one spatial coverage."@en .


###  http://purl.org/spatialai/stad/v2/core#SpatialCoverage
stad:SpatialCoverage rdf:type owl:Class ;
                     rdfs:subClassOf geo:Feature ;
                     rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                     rdfs:label "spatial coverage"@en ;
                     skos:definition "The spatial extent, typically an area, over which base data are aggregated or a dataset applies."@en .


###  http://purl.org/spatialai/stad/v2/core#SpatialResolution
stad:SpatialResolution rdf:type owl:Class ;
                       rdfs:subClassOf stad:ResolutionDescriptor ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty stad:hasQualityKind ;
                                         owl:hasValue stad:spatialResolutionQualityKind
                                       ] ;
                       rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                       rdfs:label "spatial resolution"@en ;
                       skos:definition "A resolution descriptor characterizing the spatial granularity or spatial sampling of a dataset."@en .


###  http://purl.org/spatialai/stad/v2/core#SpatioTemporalAggregateDatapoint
stad:SpatioTemporalAggregateDatapoint rdf:type owl:Class ;
                                      rdfs:subClassOf [ owl:intersectionOf ( stad:SpatialAggregateDatapoint
                                                                             stad:TemporalAggregateDatapoint
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                      rdfs:comment "All quantities that are aggregated over both space and time"@en ;
                                      rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                      rdfs:label "spatio-temporal aggregate datapoint"@en ;
                                      skos:definition "A statistical aggregate datapoint aggregated over both space and time."@en .


###  http://purl.org/spatialai/stad/v2/core#StatisticalAggregateDatapoint
stad:StatisticalAggregateDatapoint rdf:type owl:Class ;
                                   rdfs:subClassOf stad:ComputationalDatapoint ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty stad:hasAggregationPeriod ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty stad:hasSpatialCoverage ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty stad:hasTemporalCoverage ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ;
                                   rdfs:comment "All quantities that are the statistical summary of a base quantity"@en ;
                                   rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                   rdfs:label "statistical aggregate datapoint"@en ;
                                   skos:definition "A computational datapoint whose value is a statistical summary of base data."@en .


###  http://purl.org/spatialai/stad/v2/core#TemporalAggregateDatapoint
stad:TemporalAggregateDatapoint rdf:type owl:Class ;
                                rdfs:subClassOf stad:StatisticalAggregateDatapoint ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty stad:hasAggregationPeriod ;
                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty stad:hasTemporalCoverage ;
                                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                                ] ;
                                rdfs:comment "All quantities that are aggregated over time"@en ;
                                rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                rdfs:label "temporal aggregate datapoint"@en ;
                                skos:definition "A statistical aggregate datapoint aggregated over time and having exactly one temporal coverage and one aggregation period."@en .


###  http://purl.org/spatialai/stad/v2/core#TemporalCoverage
stad:TemporalCoverage rdf:type owl:Class ;
                      rdfs:subClassOf time:ProperInterval ;
                      rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                      rdfs:label "temporal coverage"@en ;
                      skos:definition "The proper interval giving the overall temporal boundaries of a dataset or statistical aggregate datapoint."@en .


###  http://purl.org/spatialai/stad/v2/core#TemporalResolution
stad:TemporalResolution rdf:type owl:Class ;
                        rdfs:subClassOf stad:ResolutionDescriptor ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty stad:hasQuantitativeValue ;
                                          owl:allValuesFrom time:TemporalDuration
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty stad:hasQualityKind ;
                                          owl:hasValue stad:temporalResolutionQualityKind
                                        ] ;
                        rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                        rdfs:label "temporal resolution"@en ;
                        skos:definition "A resolution descriptor characterizing the temporal granularity or spacing of observations in a dataset."@en .


###  http://purl.org/spatialai/stad/v2/core#TemporalSpacingResolution
stad:TemporalSpacingResolution rdf:type owl:Class ;
                               rdfs:subClassOf stad:TemporalResolution ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty stad:hasTransformationKind ;
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                               ] ;
                               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                               rdfs:label "temporal spacing resolution"@en ;
                               skos:definition "A temporal resolution expressed by a statistical summary of intervals between observations."@en .


###  http://www.opengis.net/ont/geosparql#Feature
geo:Feature rdf:type owl:Class ;
            rdfs:subClassOf geo:SpatialObject ;
            owl:disjointWith geo:Geometry ;
            rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#> ;
            rdfs:label "feature"@en ;
            skos:definition "A discrete spatial phenomenon in a universe of discourse."@en ;
            skos:note "A Feature represents a uniquely identifiable phenomenon, for example a river or an apple. While such phenomena (and therefore the Features used to represent them) are bounded, their boundaries may be crisp (e.g., the declared boundaries of a state), vague (e.g., the delineation of a valley versus its neighboring mountains), and change with time (e.g., a storm front). While discrete in nature, Features may be created from continuous observations, such as an isochrone that determines the region that can be reached by ambulance within 5 minutes."@en ;
            skos:prefLabel "Feature"@en .


###  http://www.opengis.net/ont/geosparql#Geometry
geo:Geometry rdf:type owl:Class ;
             rdfs:subClassOf geo:SpatialObject ;
             rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#> ;
             rdfs:label "geometry"@en ;
             skos:definition "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."@en ;
             skos:note "Geometry can be used as a representation of the shape, extent or location of a Feature and may exist as a self-contained entity."@en ;
             skos:prefLabel "Geometry"@en .


###  http://www.opengis.net/ont/geosparql#SpatialObject
geo:SpatialObject rdf:type owl:Class ;
                  rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#> ;
                  rdfs:label "spatial object"@en ;
                  skos:definition "Anything spatial (being or having a shape, position or an extent)."@en ;
                  skos:note "Subclasses of this class are expected to be used for instance data."@en ;
                  skos:prefLabel "Spatial Object"@en .


###  http://www.w3.org/2006/time#Instant
time:Instant rdf:type owl:Class ;
             rdfs:subClassOf time:TemporalEntity ;
             owl:disjointWith time:ProperInterval ;
             rdfs:comment "A temporal entity with zero extent or duration"@en ;
             rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
             rdfs:label "Time instant"@en ;
             skos:definition "A temporal entity with zero extent or duration"@en .


###  http://www.w3.org/2006/time#Interval
time:Interval rdf:type owl:Class ;
              rdfs:subClassOf time:TemporalEntity ;
              rdfs:comment "A temporal entity with an extent or duration"@en ;
              rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
              rdfs:label "Time interval"@en ;
              skos:definition "A temporal entity with an extent or duration"@en .


###  http://www.w3.org/2006/time#ProperInterval
time:ProperInterval rdf:type owl:Class ;
                    rdfs:subClassOf time:Interval ;
                    rdfs:comment "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en ;
                    rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                    rdfs:label "Proper interval"@en ;
                    skos:definition "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en .


###  http://www.w3.org/2006/time#TemporalAggregate
time:TemporalAggregate rdf:type owl:Class ;
                       rdfs:subClassOf time:TemporalEntity ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty time:hasPart ;
                                         owl:minCardinality "1"^^xsd:nonNegativeInteger
                                       ] ;
                       rdfs:comment """A temporal aggregate is temporal entity that is an aggregation of temporal entities

Note: no ordering relationships are implied amongst the parts. Relationships between temporal entities are supported by explicit properties, such as time:after time:intervalMeets, etc""" ;
                       rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                       rdfs:label "Temporal aggregate" ;
                       skos:definition "A temporal entity that is an aggregation of one or more temporal entities, without implied ordering among its parts."@en ;
                       skos:example """
ex:VicSchoolTerms2020
  a time:TemporalAggregate ;
  rdfs:label \"Public school year - Victoria 2020 \" ;
  time:hasBeginning ex:t1b ;
  time:hasEnd ex:t4e ;
  time:hasPart ex:t1 ;
  time:hasPart ex:t2 ;
  time:hasPart ex:t3 ;
  time:hasPart ex:t4 ;
.
""" .


###  http://www.w3.org/2006/time#TemporalDuration
time:TemporalDuration rdf:type owl:Class ;
                      rdfs:comment "Time extent; duration of a time interval separate from its particular start position"@en ;
                      rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                      rdfs:label "Temporal duration"@en ;
                      skos:definition "Time extent; duration of a time interval separate from its particular start position"@en .


###  http://www.w3.org/2006/time#TemporalEntity
time:TemporalEntity rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:unionOf ( time:Instant
                                                        time:Interval
                                                      )
                                        ] ;
                    rdfs:subClassOf owl:Thing ;
                    rdfs:comment "A temporal interval or instant."@en ;
                    rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
                    rdfs:label "Temporal entity"@en ;
                    skos:definition "A temporal interval or instant."@en .


#################################################################
#    Individuals
#################################################################

###  http://purl.org/spatialai/stad/v2/core#ArithmeticMeanCalculation
stad:ArithmeticMeanCalculation rdf:type owl:NamedIndividual ,
                                        stad:AverageCalculationDataTransformation ;
                               rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                               rdfs:label "arithmetic mean calculation"@en ;
                               skos:definition "A data transformation that calculates the arithmetic mean of input values."@en .


###  http://purl.org/spatialai/stad/v2/core#GeometricMeanCalculation
stad:GeometricMeanCalculation rdf:type owl:NamedIndividual ,
                                       stad:AverageCalculationDataTransformation ;
                              rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                              rdfs:label "geometric mean calculation"@en ;
                              skos:definition "A data transformation that calculates the geometric mean of input values."@en .


###  http://purl.org/spatialai/stad/v2/core#MaximumCalculation
stad:MaximumCalculation rdf:type owl:NamedIndividual ,
                                 stad:ExtremumCalculationDataTransformation ;
                        rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                        rdfs:label "maximum calculation"@en ;
                        skos:definition "A data transformation that returns the maximum input value."@en .


###  http://purl.org/spatialai/stad/v2/core#MedianCalculation
stad:MedianCalculation rdf:type owl:NamedIndividual ,
                                stad:CentralTendencyCalculationDataTransformation ;
                       rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                       rdfs:label "median calculation"@en ;
                       skos:definition "A data transformation that calculates the median of a set of values."@en .


###  http://purl.org/spatialai/stad/v2/core#MinimumCalculation
stad:MinimumCalculation rdf:type owl:NamedIndividual ,
                                 stad:ExtremumCalculationDataTransformation ;
                        rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                        rdfs:label "minimum calculation"@en ;
                        skos:definition "A data transformation that returns the minimum input value."@en .


###  http://purl.org/spatialai/stad/v2/core#ModeCalculation
stad:ModeCalculation rdf:type owl:NamedIndividual ,
                              stad:CentralTendencyCalculationDataTransformation ;
                     rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                     rdfs:label "mode calculation"@en ;
                     skos:definition "A data transformation that returns the most frequently occurring input value."@en .


###  http://purl.org/spatialai/stad/v2/core#spatialResolutionQualityKind
stad:spatialResolutionQualityKind rdf:type owl:NamedIndividual ,
                                           stad:QualityKind ;
                                  rdfs:isDefinedBy <http://purl.org/spatialai/stad/v2/core/> ;
                                  rdfs:label "spatial resolution"@en ;
                                  skos:definition "The quality kind describing the spatial granularity or spatial sampling of a dataset."@en .


###  http://purl.org/spatialai/stad/v2/core#temporalResolutionQualityKind
