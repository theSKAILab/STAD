ex:WinterMonth2013-2022 a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ex:TimeInterval_2013-2022 ;
            owl:onProperty time:intervalIn ],
        ex:WinterMonth .

ex:AxisParameterSetting a stad-mls:ParameterSetting ;
    stad-mls:hasValue "0"^^xsd:int ;
    stad-mls:specifiedBy ex:AxisParameter .

ex:NumericOnlyParameterSetting a stad-mls:ParameterSetting ;
    stad-mls:hasValue false ;
    stad-mls:specifiedBy ex:NumericOnlyParameter .

ex:SkipNaParameterSetting a stad-mls:ParameterSetting ;
    stad-mls:hasValue true ;
    stad-mls:specifiedBy ex:SkipNaParameter .

ex:AxisParameter a stad-mls:Parameter .

ex:NumericOnlyParameter a stad-mls:Parameter .

ex:SkipNaParameter a stad-mls:Parameter .

ex:SummerMonth a owl:Class ;
    rdfs:subClassOf time:ProperInterval .

ex:WinterMonth a owl:Class ;
    rdfs:subClassOf time:ProperInterval .

ex:OneMonthDuration a time:Duration ;
    time:numericDuration 1.0 ;
    time:unitType time:unitMonth .

ex:TemperatureQualityKind a owl:Class ;
    rdfs:label "Temperature Quality Kind"^^xsd:string ;
    rdfs:subClassOf stad:QualityKind .

ex:August a owl:Class ;
    rdfs:subClassOf ex:SummerMonth,
        time:ProperInterval ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty time:hasBeginning ;
                        owl:someValuesFrom ex:BeginningOfAugust ] [ a owl:Restriction ;
                        owl:onProperty time:hasEnd ;
                        owl:someValuesFrom ex:EndOfAugust ] [ a owl:Restriction ;
                        owl:hasValue ex:OneMonthDuration ;
                        owl:onProperty time:hasDuration ] ) ] .

ex:December a owl:Class ;
    rdfs:subClassOf ex:WinterMonth,
        time:ProperInterval ;
    owl:equivalentClass [ a owl:Class ;
