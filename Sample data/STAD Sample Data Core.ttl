@prefix ex: <http://stad.spatialai.org/example/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stad: <http://purl.org/spatialai/stad/v2/core#> .
@prefix stad-mls: <http://purl.org/spatialai/stad/v2/mls#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://stad.spatialai.org/core/v1/> a owl:Ontology ;
    owl:imports <http://www.w3.org/2006/time>,
        <https://raw.githubusercontent.com/w3c/sdw/gh-pages/time-aggregates/rdf/time-agg.ttl> .

ex:AnnualMeanTemperature a stad:QualityKind,
        ex:TemperatureQualityKind ;
    rdfs:label "Annual Mean Temperature"^^xsd:string .

ex:DailyMaximumTemperature a stad:QualityKind,
        ex:TemperatureQualityKind ;
    rdfs:label "Daily Maximum Temperature"^^xsd:string .

ex:DailyMeanTemperature a stad:QualityKind,
        ex:TemperatureQualityKind ;
    rdfs:label "Daily Mean Temperature"^^xsd:string .

ex:DailyMinimumTemperature a stad:QualityKind,
        ex:TemperatureQualityKind ;
    rdfs:label "Daily Minimum Temperature"^^xsd:string .

ex:HubbardBrookWeatherStation a stad:SpatialCoverage,
        geo:Feature ;
    ex:hasStationID "2069"^^xsd:nonNegativeInteger ;
    geo:hasGeometry [ a geo:Geometry ;
            geo:asWKT "<http://www.opengis.net/def/crs/EPSG/8.5/4326>POINT (-71.71666667 43.93333333)"^^geo:wktLiteral ] .

ex:MascomaRiverWeatherStation a stad:SpatialCoverage,
        geo:Feature ;
    ex:hasStationID "2043"^^xsd:nonNegativeInteger ;
    geo:hasGeometry [ a geo:Geometry ;
            geo:asWKT "<http://www.opengis.net/def/crs/EPSG/8.5/4326>POINT (-72.0333333 43.7833333)"^^geo:wktLiteral ] .

ex:MeasureInDegreeCelsius a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue unit:DEG_C ;
            owl:onProperty qudt:unit ],
        qudt:QuantityValue .

