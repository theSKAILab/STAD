ex:Month_2013_01 a ex:January,
        time:ProperInterval ;
    time:hasBeginning [ a time:Instant ;
            time:inXSDDateTimeStamp "2013-01-01T00:00:00-05:00"^^xsd:dateTimeStamp ] ;
    time:hasEnd [ a time:Instant ;
            time:inXSDDateTimeStamp "2013-01-31T23:00:00-05:00"^^xsd:dateTimeStamp ] ;
    time:intervalIn ex:TimeInterval_2013-2022 ;
    time:isPartOf ex:WinterAggregate2013-2022 .

