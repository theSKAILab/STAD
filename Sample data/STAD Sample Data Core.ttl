ex:BeginningOfAugust a owl:Class ;
    rdfs:subClassOf time:Instant ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty time:inDateTime ;
            owl:someValuesFrom ex:BAugDTD ] .

