ex:ObservedTemperature a stad:QualityKind,
        ex:TemperatureQualityKind ;
    rdfs:label "Observed Temperature"^^xsd:string .

ex:SCAN_BaseDataDescription a stad:DatasetDescription ;
    stad:hasSpatialResolution [ a stad:PointSpacingResolution ;
            stad:hasQualityKind stad:spatialResolutionQualityKind ;
            stad:hasQuantitativeValue [ a stad:QuantitativeValue,
                        qudt:QuantityValue ;
                    qudt:numericValue 30.0 ;
                    qudt:unit unit:KiloM ] ;
            stad:hasTransformationKind stad:ArithmeticMeanCalculation ] ;
    stad:hasTemporalResolution [ a stad:TemporalResolution ;
            stad:hasQualityKind stad:temporalResolutionQualityKind ;
            stad:hasQuantitativeValue [ a stad:QuantitativeValue,
                        time:Duration ;
                    time:numericDuration 1.0 ;
                    time:unitType time:unitHour ] ] .
					
ex:HourlySiteTemperatureDatasetDescription
    a stad:DatasetDescription ;
    stad:hasTemporalResolution ex:HourlyTemporalResolution .

ex:HourlyTemporalResolution
    a stad:TemporalResolution ;
    stad:hasQualityKind stad:temporalResolutionQualityKind ;
    stad:hasQuantitativeValue [
        a time:Duration, stad:QuantitativeValue ;
        time:numericDuration "1.0"^^xsd:decimal ;
        time:unitType time:unitHour
    ] .

ex:SummerMeanTemperature a stad:QualityKind,
        ex:TemperatureQualityKind ;
    rdfs:label "Summer Mean Temperature"^^xsd:string .

ex:SummerMonth2013-2022 a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue ex:TimeInterval_2013-2022 ;
            owl:onProperty time:intervalIn ],
        [ a owl:Restriction ;
            owl:hasValue ex:SummerAggregate2013-2022 ;
            owl:onProperty time:isPartOf ],
        ex:SummerMonth .

ex:WinterMeanTemperature a stad:QualityKind,
        ex:TemperatureQualityKind ;
    rdfs:label "Winter Mean Temperature"^^xsd:string .

ex:hasStationID a owl:DatatypeProperty ;
    rdfs:domain geo:Feature ;
    rdfs:range xsd:nonNegativeInteger .

ex:ArithmeticMaximumImplementationInPandas a stad-mls:Implementation ;
    stad-mls:hasParameter ex:AxisParameter,
        ex:NumericOnlyParameter,
        ex:SkipNaParameter ;
    stad-mls:implements stad:MaximumCalculation .

ex:ArithmeticMeanImplementationInPandas a stad-mls:Implementation ;
    stad-mls:hasParameter ex:AxisParameter,
        ex:NumericOnlyParameter,
        ex:SkipNaParameter ;
    stad-mls:implements stad:ArithmeticMeanCalculation .

ex:ArithmeticMinimumImplementationInPandas a stad-mls:Implementation ;
    stad-mls:hasParameter ex:AxisParameter,
        ex:NumericOnlyParameter,
        ex:SkipNaParameter ;
    stad-mls:implements stad:MinimumCalculation .

ex:BAugDTD a owl:Class ;
    rdfs:subClassOf time:DateTimeDescription ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue "---01"^^xsd:gDay ;
                        owl:onProperty time:day ] [ a owl:Restriction ;
                        owl:hasValue "--08"^^xsd:gMonth ;
                        owl:onProperty time:month ] [ a owl:Restriction ;
                        owl:onProperty time:year ;
                        owl:someValuesFrom xsd:gYear ] ) ] .

ex:BDecDTD a owl:Class ;
    rdfs:subClassOf time:DateTimeDescription ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue "---01"^^xsd:gDay ;
                        owl:onProperty time:day ] [ a owl:Restriction ;
                        owl:hasValue "--12"^^xsd:gMonth ;
                        owl:onProperty time:month ] [ a owl:Restriction ;
                        owl:onProperty time:year ;
                        owl:someValuesFrom xsd:gYear ] ) ] .

ex:BFebDTD a owl:Class ;
    rdfs:subClassOf time:DateTimeDescription ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:hasValue "---01"^^xsd:gDay ;
                        owl:onProperty time:day ] [ a owl:Restriction ;
                        owl:hasValue "--02"^^xsd:gMonth ;
                        owl:onProperty time:month ] [ a owl:Restriction ;
                        owl:onProperty time:year ;
                        owl:someValuesFrom xsd:gYear ] ) ] .

ex:BJanDTD a owl:Class ;
    rdfs:subClassOf time:DateTimeDescription ;
    owl:equivalentClass [ a owl:Class ;
