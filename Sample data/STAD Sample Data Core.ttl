            owl:onProperty stad-mls:executes ],
        [ a owl:Restriction ;
            owl:hasValue stad:MaximumCalculation ;
            owl:onProperty stad-mls:realizes ],
        [ a owl:Restriction ;
            owl:hasValue ex:AxisParameterSetting ;
            owl:onProperty stad-mls:hasInput ],
        [ a owl:Restriction ;
            owl:hasValue ex:SkipNaParameterSetting ;
            owl:onProperty stad-mls:hasInput ],
        [ a owl:Restriction ;
            owl:hasValue ex:NumericOnlyParameterSetting ;
            owl:onProperty stad-mls:hasInput ],
        stad-mls:AlgorithmExecution .

