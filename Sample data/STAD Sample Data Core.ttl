ex:SummerAggregate2013-2022Extent a time:ProperInterval ;
    time:hasBeginning [ a time:Instant ;
            time:inXSDDateTimeStamp "2013-06-01T00:00:00-05:00"^^xsd:dateTimeStamp ] ;
    time:hasEnd [ a time:Instant ;
            time:inXSDDateTimeStamp "2022-08-31T23:00:00-05:00"^^xsd:dateTimeStamp ] .

ex:WinterAggregate2013-2022Extent a time:ProperInterval ;
