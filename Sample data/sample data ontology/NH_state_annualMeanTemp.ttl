ex:NH_MeanTemp2013 a stad:QuantitativeDatapoint,
        stad:SpatioTemporalAggregateDatapoint ;
    stad:generatedBy ex:ArithmeticMeanExecutionAnnual_NH_2013 ;
    stad:hasAggregationPeriod ex:NH_MeanTemp2013_AggregationPeriod ;
    stad:hasBaseDataset ex:NH_Dataset_2013 ;
    stad:hasQualityKind ex:AnnualMeanTemperature ;
    stad:hasQuantitativeValue [ a stad:QuantitativeValue,
                qudt:QuantityValue ;
            qudt:numericValue "5.87"^^xsd:float ;
            qudt:unit unit:DEG_C ] ;
    stad:hasSpatialCoverage ex:NewHampshire ;
    stad:hasTemporalCoverage ex:TimeInterval_2013 ;
    stad:hasTransformationKind stad:ArithmeticMeanCalculation .

