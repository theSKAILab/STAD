@prefix ex: <http://stad.spatialai.org/example/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stad: <http://purl.org/spatialai/stad/v2/core#> .
@prefix stad-mls: <http://purl.org/spatialai/stad/v2/mls#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ClimateNA_DailyMeanTemperature_NH_20130131 a stad:SpatioTemporalAggregateDatapoint ;
    stad:generatedBy ex:ClimateNA_DailyMeanExecution ;
    stad:hasAggregationPeriod ex:NH_20130131_AggregationPeriod ;
    stad:hasBaseDataset ex:ClimateNA_Temperature_Dataset ;
    stad:hasQualityKind ex:DailyMeanTemperature ;
    stad:hasSpatialCoverage ex:NewHampshire ;
    stad:hasTemporalCoverage ex:NH_20130131_TemporalCoverage ;
    stad:hasTransformationKind stad:ArithmeticMeanCalculation .

ex:NOAA_DailyMeanTemperature_NH_20130131 a stad:SpatioTemporalAggregateDatapoint ;
    stad:generatedBy ex:NOAA_DailyMeanExecution ;
    stad:hasAggregationPeriod ex:NOAA_NH_20130131_AggregationPeriod ;
    stad:hasBaseDataset ex:NOAA_Temperature_Dataset ;
    stad:hasQualityKind ex:DailyMeanTemperature ;
    stad:hasSpatialCoverage ex:NewHampshire ;
    stad:hasTemporalCoverage ex:NH_20130131_TemporalCoverage ;
    stad:hasTransformationKind stad:ArithmeticMeanCalculation .

ex:ClimateNA_DailyMeanExecution a stad-mls:AlgorithmExecution,
        ex:PandasArithmeticMeanExecution ;
    stad-mls:executes ex:ArithmeticMeanImplementationInPandas ;
    stad-mls:hasInput ex:AxisParameterSetting,
        ex:ClimateNA_Temperature_Dataset,
        ex:NumericOnlyParameterSetting,
        ex:SkipNaParameterSetting ;
    stad-mls:realizes stad:ArithmeticMeanCalculation .

ex:ClimateNA_DatasetDescription a stad:DatasetDescription ;
    stad:hasSpatialResolution [ a stad:PointSpacingResolution ;
            stad:hasQuantitativeValue [ a qudt:QuantityValue ;
                    qudt:numericValue 10.0 ;
                    qudt:unit unit:KiloM ] ;
            stad:hasTransformationKind stad:ArithmeticMeanCalculation ] ;
    stad:hasTemporalResolution [ a stad:TemporalResolution ;
            stad:hasQuantitativeValue [ a time:Duration ;
                    time:numericDuration 1.0 ;
                    time:unitType time:unitHour ] ] .

ex:NOAA_DailyMeanExecution a stad-mls:AlgorithmExecution,
        ex:PandasArithmeticMeanExecution ;
    stad-mls:executes ex:ArithmeticMeanImplementationInPandas ;
    stad-mls:hasInput ex:AxisParameterSetting,
        ex:NOAA_Temperature_Dataset,
        ex:NumericOnlyParameterSetting,
        ex:SkipNaParameterSetting ;
    stad-mls:realizes stad:ArithmeticMeanCalculation .

ex:NOAA_DatasetDescription a stad:DatasetDescription ;
    stad:hasSpatialResolution [ a stad:PointSpacingResolution ;
            stad:hasQuantitativeValue [ a qudt:QuantityValue ;
                    qudt:numericValue 50.0 ;
                    qudt:unit unit:KiloM ] ;
            stad:hasTransformationKind stad:ArithmeticMeanCalculation ] ;
    stad:hasTemporalResolution [ a stad:TemporalResolution ;
            stad:hasQuantitativeValue [ a time:Duration ;
                    time:numericDuration 2.0 ;
                    time:unitType time:unitHour ] ] .

ex:NOAA_NH_20130131_AggregationPeriod a stad:ConvexAggregationPeriod ;
    stad:hasExtent ex:NOAA_NH_20130131_AggregationPeriodExtent ;
    time:hasPart ex:NOAA_NH_20130131_AggregationPeriodExtent .

ex:ClimateNA_Temperature_Dataset a stad:Dataset ;
    rdfs:label "ClimateNA Temperature Dataset" ;
    stad:hasDatasetDescription ex:ClimateNA_DatasetDescription .

ex:NOAA_NH_20130131_AggregationPeriodExtent a time:ProperInterval ;
    time:hasBeginning [ a time:Instant ;
            time:inXSDDateTimeStamp "2013-01-31T06:00:00-05:00"^^xsd:dateTimeStamp ] ;
    time:hasEnd [ a time:Instant ;
            time:inXSDDateTimeStamp "2013-01-31T18:00:00-05:00"^^xsd:dateTimeStamp ] .

ex:NOAA_Temperature_Dataset a stad:Dataset ;
    rdfs:label "NOAA Temperature Dataset" ;
    stad:hasDatasetDescription ex:NOAA_DatasetDescription .

ex:SCAN_DailyMeanTemperature_NH_20210301_MM a stad:QuantitativeDatapoint,
        stad:SpatioTemporalAggregateDatapoint ;
    stad:generatedBy ex:ArithmeticMeanExecutionDMT_NH_20210301_MM ;
    stad:hasAggregationPeriod ex:NH_20210301_AggregationPeriod ;
    stad:hasBaseDataset ex:Dataset_NH_20210301_MinMax ;
    stad:hasQualityKind ex:DailyMeanTemperature ;
    stad:hasQuantitativeValue [ a stad:QuantitativeValue,
                qudt:QuantityValue ;
            qudt:numericValue "-3.65"^^xsd:float ;
            qudt:unit unit:DEG_C ] ;
    stad:hasSpatialCoverage ex:NewHampshire ;
    stad:hasTemporalCoverage ex:NH_20210301_TemporalCoverage ;
    stad:hasTransformationKind stad:ArithmeticMeanCalculation .

ex:Dataset_NH_20210301_MinMax a stad:Dataset ;
    stad:containsDatapoint ex:DailyMaxTemperature_NH_20210301,
        ex:DailyMinTemperature_NH_20210301 ;
    stad:hasDatasetDescription ex:SCAN_BaseDataDescription .

ex:ArithmeticMeanExecutionDMT_NH_20210301_MM a stad-mls:AlgorithmExecution,
        ex:PandasArithmeticMeanExecution ;
    stad-mls:executes ex:ArithmeticMeanImplementationInPandas ;
    stad-mls:hasInput ex:AxisParameterSetting,
        ex:Dataset_NH_20210301_MinMax,
        ex:NumericOnlyParameterSetting,
        ex:SkipNaParameterSetting ;
    stad-mls:realizes stad:ArithmeticMeanCalculation .